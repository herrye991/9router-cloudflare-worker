# Copy to `.dev.vars` for `wrangler dev` (local secrets). NEVER commit the real file.
# For production use `wrangler secret put API_KEY_SECRET` instead.
#
# IMPORTANT: this MUST equal the 9Router app's API_KEY_SECRET (default
# "endpoint-proxy-api-key-secret"), otherwise API keys generated by the dashboard
# will fail CRC validation at the edge.
API_KEY_SECRET=endpoint-proxy-api-key-secret
